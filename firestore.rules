rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- AUTH HELPERS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // FIX: Separated prod and training role helpers.
    // getProdRole only reads /users — never training_guests.
    function getProdRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : 'guest';
    }

    // getTrainingRole reads /training_guests (Training mode)
    function getTrainingRole() {
      let path = /databases/$(database)/documents/training_guests/$(request.auth.uid);
      return exists(path) ? get(path).data.role : 'guest';
    }

    // FIX: isProdFOOrAdmin only reads prod users collection.
    // This prevents the spurious 10-read limit errors on analytics.
    function isProdFOOrAdmin() {
      let r = getProdRole();
      return r == 'fo' || r == 'admin';
    }

    function isProdAdmin() {
      return getProdRole() == 'admin';
    }

    function isFOorAdmin() {
      return isProdFOOrAdmin() || isTrainingFOOrAdmin();
    }

    // Admin = production admin ONLY. Training users may self-declare an "admin"
    // role inside the sandbox (training_*) but must never gain access to
    // production collections like messages/testimonials.
    function isAdmin() {
      return isProdAdmin();
    }

    // Training sandbox access: any signed-in user (including anonymous
    // trainees) may use training_* collections. No custom claims are issued
    // (no backend), so gates are identity-based. Blast radius is sandbox-only:
    // prod collections never grant anything on training identity.
    function isTrainingParticipant() {
      return isAuthenticated();
    }

    // Training staff powers come from the trainee's own training_guests doc
    // (role self-declared at join). Worst case a trainee promotes themself
    // inside the sandbox — production is untouched.
    function isTrainingFOOrAdmin() {
      return isAuthenticated() &&
              get(/databases/$(database)/documents/training_guests/$(request.auth.uid)).data.role in ['fo', 'admin'];
    }

    // Guest read-only access to payments linked to their own prod booking (Phase 18.3 folio).
    function ownsProdBooking(bookingId) {
      let path = /databases/$(database)/documents/bookings/$(bookingId);
      return exists(path) && get(path).data.guestId == request.auth.uid;
    }

    // Guests may review only rooms from their own completed (Checked Out) bookings.
    function guestCanReviewBooking(bookingId) {
      let path = /databases/$(database)/documents/bookings/$(bookingId);
      return bookingId is string &&
             exists(path) &&
             get(path).data.guestId == request.auth.uid &&
             get(path).data.status == 'Checked Out';
    }

    // --- BOOKING PRICE VALIDATION ---
    // The browser computes the total in createBooking(); these helpers re-derive
    // it from the room document so a DevTools client cannot forge totalCost.
    // Keep the defaults in lockstep with src/lib/roomCapacity.js
    // (ROOM_TYPE_CAPACITY_DEFAULTS + getRoomCapacity's unknown-type fallback).
    function defaultBasePax(roomType) {
      return roomType == 'Single Room' ? 1 : roomType == 'Presidential Room' ? 4 : 2;
    }

    function defaultExtraPaxFee(roomType) {
      return roomType == 'Single Room' ? 300 : roomType == 'Presidential Room' ? 1000 : 500;
    }

    // Shared by the prod and training inbox rules so the two lists can never
    // drift apart. The client writes exactly these `type` values into
    // notifications/{uid}/items via notificationService.createNotification().
    function isNotificationType(t) {
      return t in [
        'booking_request', 'booking_approved', 'booking_rejected', 'booking_cancelled',
        'stay_extended',
        'room_dirty', 'announcement', 'support_message',
        'cancellation_requested', 'cancellation_approved', 'cancellation_rejected',
        'payment_proof_required', 'housekeeping_in_progress', 'housekeeping_done',
        'housekeeping_cancelled', 'housekeeping_rated'
      ];
    }

    // True when the payload's price fields are exactly what the room's rate and
    // capacity produce for the stated nights/pax — and when `nights` actually
    // matches the [checkInDate, checkOutDate] span (see bookingNightsMatchDates).
    function bookingPriceIsValid(data) {
      let room = get(/databases/$(database)/documents/rooms/$(data.roomId));
      let roomType = room.data.get('type', '');
      let rate = room.data.get('ratePerNight', 0);
      let basePax = room.data.get('basePax', defaultBasePax(roomType));
      let extraPaxFee = room.data.get('extraPaxFee', defaultExtraPaxFee(roomType));
      let extra = data.paxCount > basePax ? data.paxCount - basePax : 0;
      return data.checkInDate is timestamp &&
             data.checkOutDate is timestamp &&
             bookingNightsMatchDates(data) &&
             data.baseTotal == rate * data.nights &&
             data.extraPaxCount == extra &&
             data.extraPaxFee == extraPaxFee &&
             data.extraPaxTotal == extra * extraPaxFee * data.nights &&
             data.totalCost == data.baseTotal + data.extraPaxTotal;
    }

    // True when `nights` matches the [checkInDate, checkOutDate] span, allowing
    // +/-1h so a guest booking from a DST timezone is never wrongly denied.
    // Deliberately a SEPARATE function called after the `is timestamp` guards in
    // bookingPriceIsValid: a `let` at the top of that body would be evaluated
    // before the guards and error on a malformed payload.
    //
    // NOTE: use toMillis(). Two traps here:
    //   1. The rules language has no timestamp-minus-timestamp operator, so
    //      `(data.checkOutDate - data.checkInDate)` is not valid.
    //   2. rules.Timestamp.seconds() is the seconds COMPONENT (0-59), not epoch
    //      seconds, so `.seconds()` here would be tiny and always fail.
    function bookingNightsMatchDates(data) {
      let spanMillis = data.checkOutDate.toMillis() - data.checkInDate.toMillis();
      return spanMillis >= data.nights * 86400000 - 3600000 &&
             spanMillis <= data.nights * 86400000 + 3600000;
    }

    // --- PRODUCTION COLLECTIONS (Protected) ---

    match /users/{uid} {
      // Read: FO/Admin may read any user. A guest may read their OWN profile,
      // plus FO-role user docs (used when fanning out cancellation/support
      // notifications). Guests must NOT be able to enumerate other guests.
      allow read: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       (!isAnonymous() && isOwner(uid)) ||
                       (!isAnonymous() && resource.data.role == 'fo');
      allow create: if isOwner(uid) && !isAnonymous() && request.resource.data.role == 'guest';
      allow update: if (isOwner(uid) && !isAnonymous() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'email', 'phone', 'photoUrl', 'updatedAt', 'lastLoginAt', 'lastLoginIp', 'isOnline', 'lastSeenAt', 'sessions', 'lastLoginDevice', 'revokedSessions', 'currentSessionId', 'lastSessionActiveAt', 'activeSessionId', 'sessionRevokeTimestamp', 'emailVerified', 'verifiedAt', 'verificationCodeHash', 'verificationExpiresAt', 'verificationAttempts', 'verificationResendAt'])) || isProdAdmin() ||
                       (isProdFOOrAdmin() && !isAnonymous() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationCount', 'updatedAt'])) ||
                       // Guest self-increment on cancel: the cancelBooking transaction bumps
                       // the guest's own count by exactly 1. Increment check stops forgery.
                       (isOwner(uid) && !isAnonymous() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationCount', 'updatedAt']) && request.resource.data.cancellationCount == resource.data.get('cancellationCount', 0) + 1);
      allow delete: if isProdAdmin() && !isAnonymous();

      // Favorites subcollection - users can manage their own favorites
      match /favorites/{roomId} {
        allow read, create, delete: if isOwner(uid) && !isAnonymous();
      }
    }

    match /rooms/{roomId} {
      // Public catalog — the /rooms library page is browsable without signing in.
      allow read: if true;
      allow create, delete: if isProdFOOrAdmin() && !isAnonymous();
      // FO/Admin: full updates. Guests: may ONLY trigger a mid-stay housekeeping
      // request by flipping a room to "Dirty / Needs Cleaning", and may only
      // change the mid-stay fields — not price, name, capacity, or any other data.
      allow update: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       (isAuthenticated() && !isAnonymous() &&
                        (
                          // Guest: raise a mid-stay housekeeping request (room -> Dirty),
                          // tied to one of their own active bookings for THIS room.
                          (request.resource.data.status == "Dirty / Needs Cleaning" &&
                           request.resource.data.isMidStayRequest == true &&
                           request.resource.data.midStayBookingId is string &&
                           ownsProdBooking(request.resource.data.midStayBookingId) &&
                           get(/databases/$(database)/documents/bookings/$(request.resource.data.midStayBookingId)).data.roomId == roomId &&
                           get(/databases/$(database)/documents/bookings/$(request.resource.data.midStayBookingId)).data.status == 'Checked In' &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'status', 'isMidStayRequest', 'midStayNote', 'midStayGuestId',
                             'midStayGuestName', 'midStayBookingId', 'midStayRequestId',
                             'midStayRequestedAt', 'updatedAt', 'statusChangedAt'
                           ])) ||
                          // Guest: cancel their own PENDING mid-stay request (Dirty -> Occupied)
                          (resource.data.status == "Dirty / Needs Cleaning" &&
                           resource.data.isMidStayRequest == true &&
                           resource.data.midStayBookingId is string &&
                           ownsProdBooking(resource.data.midStayBookingId) &&
                           get(/databases/$(database)/documents/bookings/$(resource.data.midStayBookingId)).data.roomId == roomId &&
                           request.resource.data.status == "Occupied / Checked In" &&
                           !request.resource.data.keys().hasAny([
                             'isMidStayRequest', 'midStayNote', 'midStayGuestId',
                             'midStayGuestName', 'midStayBookingId', 'midStayRequestId',
                             'midStayRequestedAt'
                           ]) &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                             'status', 'isMidStayRequest', 'midStayNote', 'midStayGuestId',
                             'midStayGuestName', 'midStayBookingId', 'midStayRequestId',
                             'midStayRequestedAt', 'updatedAt', 'statusChangedAt'
                           ]))
                        ));
    }

    match /bookings/{id} {
      // Read: FO/Admin may read all. A guest may read only their OWN bookings.
      // Guests read occupancy via the PII-free `room_availability` collection.
      allow read: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       (!isAnonymous() && isOwner(resource.data.guestId));
      
      // CREATE: GuestId must match authenticated user.
      // Non-staff creates get a strict payload whitelist so a DevTools client
      // cannot fabricate an "Approved"/"Checked In" booking, inject payment
      // data, or attach junk fields. FO/Admin keeps full create access for
      // walk-ins and seeding. Mirrors the exact shape written by
      // bookingsService.createBooking() — update both together.
      allow create: if isAuthenticated() && 
                       !isAnonymous() &&
                       (isProdFOOrAdmin() ||
                        (request.resource.data.guestId == request.auth.uid &&
                         request.resource.data.status in ['Awaiting Payment', 'Pending'] &&
                         request.resource.data.bookingType == 'Online' &&
                         request.resource.data.roomId is string &&
                         request.resource.data.nights is number &&
                         request.resource.data.totalCost is number &&
                         request.resource.data.totalCost >= 0 &&
                         request.resource.data.paxCount is int &&
                         bookingPriceIsValid(request.resource.data) &&
                         request.resource.data.createdAt is timestamp &&
                         request.resource.data.createdAt == request.time &&
                         request.resource.data.paymentDeadline is timestamp &&
                         request.resource.data.paymentDeadline >= request.resource.data.createdAt &&
                         request.resource.data.paymentDeadline <= request.resource.data.createdAt + duration.value(48, 'h') &&
                         request.resource.data.payment.deposit == 0 &&
                         request.resource.data.payment.keys().hasOnly(['method', 'deposit']) &&
                         request.resource.data.paymentProofUrl == null &&
                         request.resource.data.proofUploadedAt == null &&
                         request.resource.data.proofVerifiedAt == null &&
                         request.resource.data.keys().hasOnly([
                           'guestId', 'roomId', 'checkInDate', 'checkOutDate', 'nights',
                           'baseTotal', 'totalCost', 'status', 'bookingType', 'paxCount',
                           'extraPaxCount', 'extraPaxFee', 'extraPaxTotal', 'specialRequests',
                           'leadGuestName', 'leadGuestEmail', 'leadGuestPhone', 'arrivalTime',
                           'payment', 'paymentProofUrl', 'paymentType', 'paymentMethod',
                           'paymentDeadline', 'proofUploadedAt', 'proofVerifiedAt',
                           'createdAt', 'updatedAt'
                         ])));

      // UPDATE: FO/Admin can update anything.
      // Guests can self-cancel their OWN bookings when status is Pending (not Awaiting Payment — 48hr expiry throttles holds).
      // Guests can request cancellation of Approved bookings.
      // Guests can upload payment proof for their OWN bookings only when status is "Awaiting Payment".
      // Guests can complete a SIMULATED gateway payment (sandbox provider) for
      // their OWN bookings — a separate whitelisted transition that writes
      // gateway fields instead of proof fields. Must stay in sync with
      // paymentGatewayService.completeSimulatedPayment().
      allow update: if (isProdFOOrAdmin() && !isAnonymous() &&
                          (request.resource.data.status != "Checked Out" ||
                           request.resource.data.payment.deposit >= resource.data.totalCost)) ||
                       (isAuthenticated() && !isAnonymous() &&
                        isOwner(resource.data.guestId) &&
                        ((resource.data.status == "Pending" && request.resource.data.status == "Cancelled") ||
                         (resource.data.status == "Approved" && request.resource.data.status == "Cancellation Requested") ||
                         (resource.data.status == "Awaiting Payment" &&
                          request.resource.data.status == "Pending" &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofUrl', 'paymentType', 'paymentMethod', 'proofUploadedAt', 'status', 'updatedAt'])) ||
                         (resource.data.status == "Awaiting Payment" &&
                          request.resource.data.status == "Pending" &&
                           request.resource.data.paymentGateway == 'simulated' &&
                           request.resource.data.gatewayRef is string &&
                           request.resource.data.gatewayRef.size() > 0 &&
                           request.resource.data.get('bankRef', '') is string &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentGateway', 'gatewayRef', 'bankRef', 'paidAt', 'status', 'updatedAt']))));

      allow delete: if isProdFOOrAdmin() && !isAnonymous();
    }

    // PII-free availability markers (PROD). Guests read occupancy here instead of
    // the `bookings` collection. Contains ONLY { roomId, date, bookingId, status }.
    match /room_availability/{markerId} {
      allow read: if isAuthenticated() && !isAnonymous();

      // Guest writes must reference a REAL booking they own that is currently
      // active — so a guest can only mark/unmark nights tied to their own hold.
      function guestOwnsActiveBooking(bookingId) {
        let ref = /databases/$(database)/documents/bookings/$(bookingId);
        return bookingId is string &&
               exists(ref) &&
               get(ref).data.guestId == request.auth.uid &&
               get(ref).data.status in ['Awaiting Payment', 'Pending', 'Approved', 'Checked In'];
      }

      // Ownership-only check for DELETE. Marker cleanup runs AFTER the booking
      // flips to a terminal status (Cancelled / Checked Out), so delete must NOT
      // require an active status — otherwise every guest-initiated cleanup is
      // denied and the marker leaks, permanently blocking the nights. Guests can
      // already delete their own ACTIVE markers, so this adds no new capability.
      // create/update still require an active booking so a guest can never
      // fabricate a hold.
      function guestOwnsBooking(bookingId) {
        let ref = /databases/$(database)/documents/bookings/$(bookingId);
        return bookingId is string &&
               exists(ref) &&
               get(ref).data.guestId == request.auth.uid;
      }

      allow create: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       (isAuthenticated() && !isAnonymous() &&
                        guestOwnsActiveBooking(request.resource.data.bookingId) &&
                        request.resource.data.status in ['Awaiting Payment', 'Pending', 'Approved', 'Checked In']);

      allow update: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       (isAuthenticated() && !isAnonymous() &&
                        guestOwnsActiveBooking(resource.data.bookingId));

      allow delete: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       (isAuthenticated() && !isAnonymous() &&
                        guestOwnsBooking(resource.data.bookingId));
    }

    match /payments/{id} {
      allow read: if (isProdFOOrAdmin() && !isAnonymous()) ||
                     (isAuthenticated() && !isAnonymous() &&
                      ((resource.data.bookingId is string &&
                        ownsProdBooking(resource.data.bookingId)) ||
                       (!(resource.data.bookingId is string) &&
                        resource.data.changedByUserId == request.auth.uid &&
                        resource.data.isMidStayRequest == true)));
      allow write: if isProdFOOrAdmin() && !isAnonymous();
    }

    // --- TRAINING COLLECTIONS (training_*) ---

    match /training_guests/{uid} {
      allow read: if isOwner(uid) || isProdFOOrAdmin() || isTrainingFOOrAdmin();
      // Trainees sign in ANONYMOUSLY, so self-creation must not require
      // !isAnonymous(). Role is self-declared so trainees can practice each
      // role; access is limited to the training_* sandbox via isTraining*.
      // Staff (prod or training) may seed demo users of any role.
      allow create: if (isProdFOOrAdmin() || isTrainingFOOrAdmin()) ||
                     (isOwner(uid) &&
                      request.resource.data.role in ['guest', 'fo', 'admin'] &&
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.keys().hasOnly(
                        ['uid', 'email', 'fullName', 'phone', 'role', 'emailVerified',
                         'createdAt', 'updatedAt']));
      // Trainees may edit only their own profile fields (never their role).
      allow update: if isProdFOOrAdmin() || isTrainingFOOrAdmin() ||
                     (isOwner(uid) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                        ['fullName', 'email', 'phone', 'photoUrl', 'updatedAt', 'lastLoginAt',
                         'lastLoginIp', 'isOnline', 'lastSeenAt', 'emailVerified', 'verifiedAt'])) ||
                     // Sandbox mirror of the guest self-increment above.
                     (isOwner(uid) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationCount', 'updatedAt']) &&
                      request.resource.data.cancellationCount == resource.data.get('cancellationCount', 0) + 1);
      allow delete: if isProdFOOrAdmin() || isTrainingFOOrAdmin();

      // Favorites subcollection — trainees can manage their own favorites in
      // the sandbox (mirrors the prod users/{uid}/favorites pattern).
      match /favorites/{roomId} {
        allow read, create, delete: if isOwner(uid);
      }
    }

    match /training_bookings/{id} {
      allow read: if isTrainingParticipant() &&
               (isTrainingFOOrAdmin() || resource.data.guestId == request.auth.uid);
      allow create: if isTrainingParticipant() && 
                       (request.resource.data.guestId == request.auth.uid || isProdFOOrAdmin() || isTrainingFOOrAdmin());
      allow update: if (isTrainingParticipant() &&
                               (isProdFOOrAdmin() || isTrainingFOOrAdmin()) &&
                               (request.resource.data.status != "Checked Out" ||
                                request.resource.data.payment.deposit >= resource.data.totalCost)) ||
                       (isTrainingParticipant() &&
                        isOwner(resource.data.guestId) &&
                        ((resource.data.status == "Pending" && request.resource.data.status == "Cancelled") ||
                         (resource.data.status == "Approved" && request.resource.data.status == "Cancellation Requested") ||
                         (resource.data.status == "Awaiting Payment" &&
                          request.resource.data.status == "Pending" &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentProofUrl', 'paymentType', 'paymentMethod', 'proofUploadedAt', 'status', 'updatedAt'])) ||
                         (resource.data.status == "Awaiting Payment" &&
                          request.resource.data.status == "Pending" &&
                           request.resource.data.paymentGateway == 'simulated' &&
                           request.resource.data.gatewayRef is string &&
                           request.resource.data.gatewayRef.size() > 0 &&
                           request.resource.data.get('bankRef', '') is string &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentGateway', 'gatewayRef', 'bankRef', 'paidAt', 'status', 'updatedAt']))));
      allow delete: if isTrainingParticipant() &&
               (isOwner(resource.data.guestId) || isProdFOOrAdmin() || isTrainingFOOrAdmin());
    }
    
    match /training_payments/{id} {
      allow read: if isTrainingParticipant() &&
               (isTrainingFOOrAdmin() ||
            (resource.data.bookingId is string &&
             get(/databases/$(database)/documents/training_bookings/$(resource.data.bookingId)).data.guestId == request.auth.uid));
      // Sandbox: any authenticated user (including anonymous trainees playing
      // FO) may create — mirrors training_rooms/training_reviews.
      allow create: if isTrainingParticipant() &&
        (isTrainingFOOrAdmin() ||
         (request.resource.data.bookingId is string &&
          get(/databases/$(database)/documents/training_bookings/$(request.resource.data.bookingId)).data.guestId == request.auth.uid));
      allow update: if isTrainingParticipant() && (isProdFOOrAdmin() || isTrainingFOOrAdmin());
      allow delete: if isTrainingParticipant() && isTrainingFOOrAdmin();
    }

    match /training_housekeeping_logs/{id} {
      allow read: if isTrainingParticipant() &&
        (isTrainingFOOrAdmin() ||
         (resource.data.bookingId is string &&
          get(/databases/$(database)/documents/training_bookings/$(resource.data.bookingId)).data.guestId == request.auth.uid));
      // Sandbox: any authenticated user (including anonymous trainees) may create.
      allow create: if isTrainingParticipant() &&
        (isTrainingFOOrAdmin() ||
         (request.resource.data.bookingId is string &&
          get(/databases/$(database)/documents/training_bookings/$(request.resource.data.bookingId)).data.guestId == request.auth.uid));
      allow update: if isTrainingParticipant() && isTrainingFOOrAdmin();
      allow delete: if isTrainingParticipant() && isTrainingFOOrAdmin();
    }

    match /training_rooms/{id} {
      // Trainees are anonymous accounts, so anonymous reads must be allowed.
      allow read: if isTrainingParticipant();
      allow write: if isTrainingParticipant() && isTrainingFOOrAdmin();
    }

    match /training_availability/{markerId} {
      // Sandbox mirror of /room_availability: PII-free { roomId, date,
      // bookingId, status } markers that form the double-booking lock for
      // training holds. Anonymous trainees must read + claim them (same
      // reason as training_rooms above); prod roles never touch this.
      allow read: if isTrainingParticipant();
      allow create, update: if isTrainingParticipant() &&
        (isTrainingFOOrAdmin() ||
         (request.resource.data.bookingId is string &&
          get(/databases/$(database)/documents/training_bookings/$(request.resource.data.bookingId)).data.guestId == request.auth.uid));
      allow delete: if isTrainingParticipant() &&
        (isTrainingFOOrAdmin() ||
         (resource.data.bookingId is string &&
          get(/databases/$(database)/documents/training_bookings/$(resource.data.bookingId)).data.guestId == request.auth.uid));
    }

    match /training_reviews/{id} {
      allow read: if isTrainingParticipant() &&
               (isTrainingFOOrAdmin() || resource.data.guestId == request.auth.uid);
      allow create: if isTrainingParticipant() && request.resource.data.guestId == request.auth.uid;
      allow update, delete: if isTrainingParticipant() &&
               (isTrainingFOOrAdmin() || resource.data.guestId == request.auth.uid);
    }

    // Sandbox mirrors for admin diagnostics — trainee "admins" can exercise
    // alerts and audit trails without touching production collections.
    match /training_system_alerts/{id} {
      allow read, write: if isTrainingParticipant() && isTrainingFOOrAdmin();
    }

    match /training_audit_logs/{id} {
      allow read, create: if isTrainingParticipant() && isTrainingFOOrAdmin();
    }

    // Training sandbox inbox. Mirrors /notifications, but every recipient here
    // is the trainee themselves or a training_* user, so there is deliberately
    // no prod-user gate — that gate exists solely to stop one real guest from
    // writing into another real guest's bell. Without this block the training
    // bell would be silent, because notificationService now resolves the
    // collection through getCol() and would write to training_notifications.
    match /training_notifications/{userId}/items/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if isAuthenticated() &&
                       isNotificationType(request.resource.data.type) &&
                       request.resource.data.isRead == false &&
                       request.resource.data.keys().hasAll(['title', 'message', 'link', 'createdAt']) &&
                       request.resource.data.link is string &&
                       request.resource.data.link.matches('^/.*');
    }

    // Training contact inbox. Mirrors /messages so trainee questions never
    // land in the production FO inbox.
    match /training_messages/{messageId} {
      allow read: if isTrainingParticipant();
      allow create: if isTrainingParticipant();
      allow update: if isTrainingParticipant() && isTrainingFOOrAdmin();
      allow delete: if isTrainingParticipant() && isTrainingFOOrAdmin();
    }

    // Training session state (holds the join code). Authenticated eyes only:
    // a world-readable code lets anyone scrape it, join the sandbox
    // uninvited, and deface the dry run. Trainees authenticate (anonymously)
    // BEFORE validating the code — see signInWithTrainingCode.
    match /users/system {
      allow read: if isAuthenticated();
      allow write: if isProdFOOrAdmin() && !isAnonymous();
    }

    // System settings (e.g. maintenance mode)
    match /system_settings/{docId} {
      allow read: if true;
      allow write: if isProdAdmin() && !isAnonymous();
    }

    // System health metrics & error logs
    match /system_health/{docId} {
      allow read: if isProdAdmin() || isProdFOOrAdmin();
      allow write: if isProdAdmin() && !isAnonymous();
    }

    match /error_logs/{docId} {
      allow read: if isProdAdmin() || isProdFOOrAdmin();
      allow write: if isProdAdmin() && !isAnonymous();
    }

    // Audit log trail for admin actions
    match /audit_logs/{logId} {
      allow read: if isProdAdmin() && !isAnonymous();
      allow create: if isProdAdmin() && !isAnonymous();
    }

    // System alerts for operational issues
    match /system_alerts/{alertId} {
      allow read: if isProdAdmin() && !isAnonymous();
      allow write: if isProdAdmin() && !isAnonymous();
    }
    
    // Additional Production Collections
    match /housekeeping_logs/{id} {
      // Staff see everything; guests see only logs tied to their own booking
      // (anon trainees are blocked outright — the sandbox has its own mirror).
      // Guest queries must constrain bookingId to their own, otherwise list
      // fails closed instead of leaking other guests' notes/photos.
      allow read: if (isProdFOOrAdmin() && !isAnonymous()) ||
                     (isAuthenticated() && !isAnonymous() &&
                      resource.data.bookingId is string &&
                      ownsProdBooking(resource.data.bookingId)) ||
                     (isAuthenticated() && !isAnonymous() &&
                      resource.data.changedByUserId == request.auth.uid &&
                      resource.data.isMidStayRequest == true &&
                      resource.data.roomId is string);
      // Guests may create ONLY their own mid-stay request/cancellation log
      // entries (the service stamps requestId + isMidStayRequest); FO/Admin
      // create entries for every room status change.
      allow create: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       (isAuthenticated() && !isAnonymous() &&
                        request.resource.data.changedByRole == 'guest' &&
                        request.resource.data.isMidStayRequest == true &&
                        request.resource.data.toStatus in ['Dirty / Needs Cleaning', 'Occupied / Checked In'] &&
                        request.resource.data.bookingId is string &&
                        ownsProdBooking(request.resource.data.bookingId) &&
                        request.resource.data.changedByUserId == request.auth.uid &&
                        request.resource.data.roomId is string &&
                        request.resource.data.photoUrls is list &&
                        request.resource.data.keys().hasOnly([
                          'roomId', 'bookingId', 'requestId', 'fromStatus', 'toStatus',
                          'changedByRole', 'changedByUserId', 'changedByName',
                          'isMidStayRequest', 'note', 'photoUrls', 'createdAt', 'updatedAt'
                        ]));
      // Guests may rate a COMPLETED housekeeping job once: update only the
      // rating fields on the completion log (toStatus == "Available") of a
      // mid-stay request tied to their own booking.
      allow update: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       (isAuthenticated() && !isAnonymous() &&
                        resource.data.isMidStayRequest == true &&
                        resource.data.toStatus == 'Available' &&
                        resource.data.bookingId is string &&
                        ownsProdBooking(resource.data.bookingId) &&
                        !resource.data.keys().hasAny(['rating']) &&
                        request.resource.data.rating is number &&
                        request.resource.data.rating >= 1 &&
                        request.resource.data.rating <= 5 &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['rating', 'ratingFeedback', 'ratedAt']
                        ));
      allow delete: if isProdFOOrAdmin() && !isAnonymous();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isProdFOOrAdmin() && !isAnonymous();
    }

    match /reviews/{id} {
      allow read: if true;
      // One review per guest per room (enforced client-side via a deterministic
      // doc id `${guestId}_${roomId}`); guests may only review rooms from their
      // own completed (Checked Out) bookings, with a valid 1-5 rating.
      allow create: if isAuthenticated() && !isAnonymous() &&
                       request.resource.data.guestId == request.auth.uid &&
                       request.resource.data.roomId is string &&
                       request.resource.data.guestName is string &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.feedback is string &&
                       request.resource.data.bookingId is string &&
                       guestCanReviewBooking(request.resource.data.bookingId) &&
                       request.resource.data.keys().hasOnly([
                         'roomId', 'bookingId', 'guestId', 'guestName', 'rating',
                         'feedback', 'createdAt', 'updatedAt'
                       ]);
      allow update: if (isProdFOOrAdmin() && !isAnonymous()) ||
                       // Owners may only touch their score + words (identity and
                       // booking link are immutable) — a DevTools client can't
                       // reassign someone else's review to itself.
                       (isAuthenticated() && !isAnonymous() &&
                        isOwner(resource.data.guestId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                          ['rating', 'feedback', 'updatedAt']) &&
                        request.resource.data.rating is number &&
                        request.resource.data.rating >= 1 &&
                        request.resource.data.rating <= 5 &&
                        request.resource.data.feedback is string &&
                        request.resource.data.feedback.size() <= 2000);
      allow delete: if (isOwner(resource.data.guestId) || isProdFOOrAdmin()) && !isAnonymous();
    }

    match /notifications/{userId}/items/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if isAuthenticated() &&
                       isNotificationType(request.resource.data.type) &&
                       request.resource.data.isRead == false &&
                       request.resource.data.keys().hasAll(['title', 'message', 'link', 'createdAt']) &&
                       request.resource.data.link is string &&
                       request.resource.data.link.matches('^/.*') &&
                       (isProdFOOrAdmin() ||
                        request.auth.uid == userId ||
                        // Only PROD user inboxes are gated: staff (FO/Admin) may
                        // still be notified by guests, but one guest can no longer
                        // inject a notification into another guest's inbox.
                        // Non-prod recipients (training sandbox) stay permissive,
                        // matching the rest of the training_* design.
                        !exists(/databases/$(database)/documents/users/$(userId)) ||
                        get(/databases/$(database)/documents/users/$(userId)).data.role in ['fo', 'admin']);
    }

    match /messages/{messageId} {
      // Contact inbox intake. Unauthenticated by design (guests ask questions
      // before signing in), so the rule enforces the exact client shape, sane
      // sizes, and a server timestamp — junk-shape spam is rejected, and
      // messageService.submitMessage adds a shared per-device 30s throttle on
      // top. True per-IP throttling would need a server endpoint; this keeps
      // honest users safe from floods only in combination with that throttle.
      allow create: if request.resource.data.get('honeypot', '') == '' &&
                       request.resource.data.keys().hasOnly(
                         ['id', 'name', 'email', 'subject', 'message', 'status',
                          'guestId', 'createdAt', 'repliedAt', 'replyMessage']) &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() >= 1 &&
                       request.resource.data.name.size() <= 100 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() <= 254 &&
                       request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
                       request.resource.data.subject is string &&
                       request.resource.data.subject.size() >= 1 &&
                       request.resource.data.subject.size() <= 200 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() >= 1 &&
                       request.resource.data.message.size() <= 5000 &&
                       request.resource.data.status == 'unread' &&
                       request.resource.data.get('repliedAt', null) == null &&
                       request.resource.data.get('replyMessage', null) == null &&
                       (request.resource.data.get('guestId', null) == null ||
                        request.resource.data.get('guestId', null) is string) &&
                       request.resource.data.createdAt == request.time;
      // FO reads + replies here (the /fo/messages inbox); only admins delete.
      allow read, update: if (isProdFOOrAdmin() && !isAnonymous());
      allow delete: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if resource.data.status == "Approved" || isAdmin();
      allow create: if isAuthenticated() && !isAnonymous() &&
                       request.resource.data.guestId == request.auth.uid &&
                       request.resource.data.status == "Pending" &&
                       request.resource.data.guestName is string &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() >= 1 &&
                       request.resource.data.message.size() <= 2000 &&
                       request.resource.data.keys().hasOnly([
                         'guestId', 'guestName', 'rating', 'message',
                         'status', 'createdAt', 'updatedAt'
                       ]);
      allow update, delete: if isAdmin() && !isAnonymous();
    }
  }
}


