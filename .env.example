# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Google Analytics 4 (optional) — Measurement ID from GA4 → Data Streams → Web
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary Configuration (unsigned upload — preset only; no API secret on client)
# IMPORTANT: Lock the upload preset in the Cloudinary dashboard (Settings → Upload):
# file type = Image only, max ~5 MB, formats jpg/png/webp. See src/services/cloudinaryService.js.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Groq (AI chatbot) — proxied server-side via Cloudflare Worker (see /worker).
# Deploy the worker first (npx wrangler deploy), then set its URL here.
# The real GROQ_API_KEY lives as a Worker secret, never in this repo.
VITE_GROQ_PROXY_URL=https://your-worker.workers.dev

# Full user deletion (Auth + Firestore) — same worker, /delete-user route.
# Must match the DELETE_KEY secret you set with `npx wrangler secret put DELETE_KEY`.
VITE_DELETE_KEY=set_a_random_passphrase_here

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_REPLY_TEMPLATE_ID=your_emailjs_reply_template_id
VITE_EMAILJS_VERIFY_TEMPLATE_ID=your_emailjs_verify_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
