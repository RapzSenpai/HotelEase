@startuml Check-In/Check-Out Activity
skinparam activity {
  BackgroundColor #F5F5F5
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFE0B2
  DiamondBorderColor #333333
}
skinparam swimlane {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Check-In / Check-Out Activity Diagram

|FO Staff|
start

switch (Action?)
case (Check-In)
  :Open Check-In page;
  :Select approved booking;
  
  |System|
  :Execute Firestore transaction;
  :Update booking status to 'Checked In';
  :Update room status to 'Occupied';
  
  |FO Staff|
  :View check-in confirmation;
  stop

case (Check-Out)
  :Open Check-Out page;
  :Select active booking;
  
  |System|
  :Execute Firestore transaction;
  :Update booking status to 'Checked Out';
  :Update room status to 'Dirty';
  
  |FO Staff|
  :Receive housekeeping notification;
  :View check-out confirmation;
  stop

endswitch

@enduml
