@startuml Guest Support Messaging Activity
skinparam activity {
  BackgroundColor #F5F5F5
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFE0B2
  DiamondBorderColor #333333
}
skinparam swimlane {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Guest Support Messaging Activity Diagram

|Guest|
start
:Open Contact page;
:Enter name;
:Enter email;
:Enter subject;
:Enter message;
:Click "Send Message";

|System|
:Save message to Firestore;
:Set status = 'unread';
:Send notification to FO staff;

|FO Staff|
:Receive in-app notification;
:Open Messages page;
:View message;
:Mark as read;
:Click "Reply";
:Enter reply message;
:Click "Send Reply";

|System|
:Save reply to Firestore;
:Update message status;

if (Email notification enabled?) then (yes)
  :Send email notification to guest;
  :Use Firebase Cloud Functions;
  :Use Nodemailer + Gmail SMTP;
else (no)
endif

|Guest|
:Receive in-app notification;
:View reply;
stop

@enduml
