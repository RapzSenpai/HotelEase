@startuml User Login Activity
skinparam activity {
  BackgroundColor #F5F5F5
  BorderColor #333333
  ArrowColor #333333
  DiamondBackgroundColor #FFE0B2
  DiamondBorderColor #333333
}
skinparam swimlane {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title User Login Activity Diagram

|User|
start
:Navigate to Login page;
:Enter email;
:Enter password;
:Click "Login";

|System|
:Validate input fields;

if (Fields valid?) then (yes)
  :Authenticate with Firebase Auth;
  
  if (Authentication successful?) then (yes)
    :Load user profile from Firestore;
    :Determine user role;
    
    switch (User Role?)
    case (Guest)
      :Redirect to Guest Dashboard;
    case (FO)
      :Redirect to FO Dashboard;
    case (Admin)
      :Redirect to Admin Dashboard;
    endswitch
    
    |User|
    :View Dashboard;
    stop
  else (no)
    |User|
    :Display "Invalid credentials" error;
    :Retry login;
    stop
  endif
else (no)
  |User|
  :Display validation errors;
  :Correct input fields;
  stop
endif

@enduml
