@startuml Housekeeping Workflow Use Case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5F5F5
  BorderColor #333333
  ArrowColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Housekeeping Workflow Use Case Diagram

rectangle "HotelEase System" {
  usecase "Update Room Status" as UC1
  usecase "View Rooms by Status" as UC2
  usecase "Mark as Being Cleaned" as UC3
  usecase "Mark as Pending Approval" as UC4
  usecase "Approve Room" as UC5
  usecase "Log Status Change" as UC6
  usecase "Notify FO Staff" as UC7
}

actor "FO/Housekeeping Staff" as Staff
actor "FO Supervisor" as Supervisor

Staff --> UC1
Staff --> UC2
UC1 --> UC3
UC3 --> UC4
UC4 --> UC5
UC5 --> Supervisor
UC1 --> UC6
UC4 --> UC7
UC7 --> Staff

note right of UC1
  Staff updates room
  cleaning status through
  workflow: Dirty → Being
  Cleaned → Pending
  Approval → Available.
end note

note bottom of UC6
  Each status change is
  logged in housekeeping_logs
  with timestamp and role.
end note

note bottom of UC5
  FO supervisor reviews
  and approves — room
  becomes 'Available'.
end note

@enduml
