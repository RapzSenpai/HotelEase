@startuml Analytics Dashboard Use Case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5F5F5
  BorderColor #333333
  ArrowColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Analytics Dashboard Use Case Diagram

rectangle "HotelEase System" {
  usecase "View Analytics Dashboard" as UC1
  usecase "Select Date Range" as UC2
  usecase "Calculate Occupancy Rate" as UC3
  usecase "Calculate Total Revenue" as UC4
  usecase "Display Booking Trend" as UC5
  usecase "Show Peak Booking Days" as UC6
  usecase "Filter by Date Range" as UC7
}

actor "Admin" as Admin

Admin --> UC1
UC1 --> UC2
UC1 --> UC3
UC1 --> UC4
UC1 --> UC5
UC1 --> UC6
UC2 --> UC7
UC7 --> UC3
UC7 --> UC4
UC7 --> UC5
UC7 --> UC6

note right of UC1
  Admin accesses Analytics
  Dashboard to view KPIs:
  occupancy rate, revenue,
  booking trends, and
  peak days.
end note

note bottom of UC3
  Occupancy rate calculated
  from booking nights vs.
  available room-nights.
end note

note bottom of UC5
  7-day booking trend
  chart displayed using
  Recharts library.
end note

@enduml
