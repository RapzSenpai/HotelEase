@startuml Check-In/Check-Out Use Case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5F5F5
  BorderColor #333333
  ArrowColor #333333
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #666666
}

title Check-In / Check-Out Use Case Diagram

rectangle "HotelEase System" {
  usecase "Process Check-In" as UC1
  usecase "Select Approved Booking" as UC2
  usecase "Update Booking Status" as UC3
  usecase "Update Room to Occupied" as UC4
  usecase "Process Check-Out" as UC5
  usecase "Select Active Booking" as UC6
  usecase "Update Booking to Checked Out" as UC7
  usecase "Update Room to Dirty" as UC8
  usecase "Notify Housekeeping" as UC9
  usecase "Generate Receipt" as UC10
}

actor "FO Staff" as FO
actor "Housekeeping" as HK

FO --> UC1
FO --> UC5
UC1 --> UC2
UC2 --> UC3
UC3 --> UC4
UC5 --> UC6
UC6 --> UC7
UC7 --> UC8
UC8 --> UC9
UC9 --> HK
UC5 --> UC10

note right of UC1
  FO staff processes guest
  check-in by transitioning
  approved booking to
  'Checked In'.
end note

note bottom of UC4
  Room status changes
  to 'Occupied'.
end note

note right of UC5
  FO staff processes
  check-out. Booking →
  'Checked Out', Room →
  'Dirty'.
end note

note bottom of UC9
  Housekeeping staff
  notified that room
  needs cleaning.
end note

@enduml
