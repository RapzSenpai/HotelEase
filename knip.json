{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/test/**/*.test.js",
    "scripts/*.mjs",
    "worker/src/index.js"
  ],
  "project": ["src/**/*.{js,jsx}", "scripts/*.mjs", "worker/src/*.js"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
